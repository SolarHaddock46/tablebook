{
  "name": "tablebook",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @tablebook/api dev",
    "mobile:dev": "pnpm --filter @tablebook/mobile dev",
    "mobile:web": "pnpm --filter @tablebook/mobile dev:web",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @tablebook/db migrate",
    "db:seed": "pnpm --filter @tablebook/db seed",
    "generate:restaurants": "tsx scripts/generate_restaurants.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
