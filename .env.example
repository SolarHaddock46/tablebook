# Copy to apps/api/.env.local (Next.js reads it automatically)
# db:migrate and db:seed also load this file automatically

DATABASE_URL=postgresql://tablebook:password@localhost:5432/tablebook
AUTH_SECRET=dev-secret-change-in-prod
ALLOWED_ORIGINS=http://localhost:8081,http://192.168.15.88:8081
HOST=0.0.0.0

# Email — pick one option:
#
# Option A (simplest): Gmail — only 2 vars, host/port are preset
# 1. Enable 2FA on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste email + 16-char app password below
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Option B: custom SMTP (Mailgun, Yandex, etc.)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=TableBook <noreply@tablebook.app>
#
# Without Gmail/SMTP, emails are logged to the API console.
APP_URL=http://localhost:8081

# apps/mobile/.env.local
EXPO_PUBLIC_API_URL=http://192.168.15.88:3000
